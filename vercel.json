{
  "cleanUrls": true,
  "trailingSlash": false,

  "redirects": [
    {
      "source": "/account",
      "destination": "/user/account/redirect?mode=checkout",
      "permanent": false
    }
  ],

  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
{
  "source": "/products/image/:filename",
  "destination": "https://apisequizeshoplite.vercel.app/api/image?filename=:filename"
},
    
    {
      "source": "/firebase-messaging-sw.js",
      "destination": "https://apisequizeshoplite.vercel.app/firebase-messaging-sw.js"
    },
    
    {
      "source": "/home",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/signup",
      "destination": "/signup.html"
    },
    {
      "source": "/address",
      "destination": "/address.html"
    },
    {
      "source": "/addresses",
      "destination": "/addresses.html"
    },
    {
      "source": "/cart",
      "destination": "/cart.html"
    },
    {
      "source": "/product",
      "destination": "/product.html"
    },
    {
      "source": "/profile",
      "destination": "/profile.html"
    },
    {
      "source": "/user/account/redirect",
      "destination": "/profile.html"
    },
    {
      "source": "/wishlist",
      "destination": "/wishlist.html"
    },
    {
      "source": "/api/logout",
      "destination": "/api/signup"
    }
  ]
}
