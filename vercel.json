{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/home",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/signup",
      "destination": "/signup.html"
    },
    {
      "source": "/address",
      "destination": "/address.html"
    },
    {
      "source": "/addresses",
      "destination": "/addresses.html"
    },
    {
      "source": "/cart",
      "destination": "/cart.html"
    },
    {
      "source": "/product",
      "destination": "/product.html"
    },
    
    {
      "source": "/profile",
      "destination": "/profile.html"
    },
    
    {
       "source": "/account",
       "destination": "/user/account/redirect?mode=checkout",
       "permanent": false
    },
    
    {
       "source": "/user/account/redirect",
       "destination": "/profile.html?mode=checkout"
    },
    
    {
      "source": "account",
      "destination": "/profile.html"
    },
    {
      "source": "/wishlist",
      "destination": "/wishlist.html"
    },
    {
       "source": "/api/logout",
       "destination": "/api/signup"
    }
  ]
}
